{
  "name": "@kanjo/web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "React SPA。HTML版のデザイントークンを移植",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run build:bundle && pnpm run check:js-budget && pnpm run strip:manifest",
    "build:artifact": "pnpm run build:bundle && pnpm run strip:manifest",
    "build:bundle": "pnpm run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:coverage:account-login": "vitest run src/account-login.dom.test.tsx src/api.test.ts --coverage.enabled --coverage.provider=v8 --coverage.reporter=text --coverage.include=src/App.tsx --coverage.include=src/api-client.ts --coverage.include=src/pages/Login.tsx --coverage.include=src/pages/PasswordChange.tsx --coverage.include=src/components/UserAdmin.tsx --coverage.thresholds.statements=80 --coverage.thresholds.branches=80 --coverage.thresholds.functions=80 --coverage.thresholds.lines=80",
    "check:js-budget": "node scripts/check-initial-js-budget.mjs",
    "strip:manifest": "node scripts/strip-vite-manifest.mjs",
    "check:thead": "node scripts/check-thead-render.mjs",
    "check:mobile-layout": "node scripts/check-mobile-layout.mjs",
    "check:financial-figure": "node scripts/check-mobile-financial-layout.mjs",
    "check:financial-routes": "node scripts/check-financial-visuals.mjs",
    "check:ai-screen": "KANJO_VISUAL_SCOPE=ai node scripts/check-financial-visuals.mjs",
    "check:analysis-hub": "node scripts/check-analysis-hub-visuals.mjs",
    "check:budget-visual": "tsx scripts/check-budget-visual.mts",
    "check:cash-screen": "KANJO_VISUAL_SCOPE=cash node scripts/check-financial-visuals.mjs",
    "check:guide-screen": "KANJO_VISUAL_SCOPE=guide node scripts/check-financial-visuals.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.1.0",
    "@kanjo/core": "workspace:*",
    "@tanstack/react-query": "^5.62.11",
    "chart.js": "^4.4.7",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.1.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vitest": "^4.1.11"
  }
}
