{
  "name": "@kanjo/web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "React SPA。HTML版のデザイントークンを移植",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && pnpm run check:js-budget",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:js-budget": "node scripts/check-initial-js-budget.mjs",
    "check:thead": "node scripts/check-thead-render.mjs",
    "check:mobile-layout": "node scripts/check-mobile-layout.mjs",
    "check:financial-figure": "node scripts/check-mobile-financial-layout.mjs",
    "check:financial-routes": "node scripts/check-financial-visuals.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.1.0",
    "@kanjo/core": "workspace:*",
    "@tanstack/react-query": "^5.62.11",
    "chart.js": "^4.4.7",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.1.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vitest": "^3.2.6"
  }
}
