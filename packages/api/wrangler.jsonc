{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kanjo-console",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": false,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /api/* は必ず Worker を通す(認証ゲート)。それ以外は静的アセット優先
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kanjo-db",
      "database_id": "fe9e732c-687c-4507-b704-1955b5367547",
      "migrations_dir": "../../migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "kanjo-files"
    }
  ],
  "triggers": {
    // JST 02:00 = UTC 17:00 前日。夜間バックアップ(D1→R2, 30日保持)
    "crons": ["0 17 * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // 値はCloudflareのsecret storeだけに置き、ここでは必須名だけを機械検証する。
  "secrets": {
    "required": ["BETTER_AUTH_SECRET", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET", "RESEND_API_KEY"]
  },
  "vars": {
    // ローカルは要求元originを使う。CIは検証済みAPP_URLを本番deploy時に必ず上書きする。
    "BETTER_AUTH_URL": "",
    // 手元から誤ってdeployした場合はメールをfail-closedにする。CIの検証済み値だけが上書きする。
    "MAIL_FROM": "",
    // Cloudflare Access を使う場合のみ設定(両方設定でAccess JWT検証へ切替)
    "ACCESS_AUD": "",
    "ACCESS_TEAM_DOMAIN": ""
  }
}
