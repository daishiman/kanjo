# ============================================================
# 実データは絶対にコミットしない（このリポジトリは public）
# freee / マネーフォワードのエクスポート、統合JSON、口座明細等
# ============================================================
/data/*
!/data/README.md
*.csv
*.xlsx
*.xls
収支管理データ_*.json
増減マトリクス.csv
# 参考実装HTML・要件定義書(実明細を含む)はローカル専用。git管理しない
/docs/reference/
# 実データを参照するローカル一時テスト。匿名fixtureへ置換するまで管理・通常検査対象外。
/packages/core/test/__tmp-*

# 匿名化済みサンプルのみ例外的に許可
!/samples/**/*.csv
!/samples/**/*.json

# ------------------------------------------------------------
# Node / ビルド
# ------------------------------------------------------------
node_modules/
dist/
build/
.cache/
*.tsbuildinfo

# ------------------------------------------------------------
# 環境変数・認証情報
# ------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
.dev.vars
.dev.vars.*
!.dev.vars.example
.wrangler/
packages/api/worker-configuration.d.ts

# AIDD同期時のローカル復旧バックアップ（実行時配置の複製）
.claude/backup-*/
.codex/backup-*/

# ------------------------------------------------------------
# OS / エディタ
# ------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
__pycache__/

# coverage.py
.coverage

# ハーネス hook が生成する作業ログ(リポジトリ直下のみ)
/eval-log/

# 外部操作ガードの受領票(作業ごとの一時記録。成果物ではない)
.artifact-delivery/

# dev-graph のローカル実行状態(config.json と templates/ は共有するのでコミットする)
.dev-graph/state/
.dev-graph/cache/
.dev-graph/locks/
.dev-graph/receipts/
.dev-graph/staging/
.dev-graph/eval-log/

# 検証スクリプトが撮るスクリーンショット(実行のたびに作り直される生成物)。
# 判定は証跡JSONの計測値が行っており、画像はそれを人が目で確かめるための補助。
# 再生成手順は各featureの evidence/phase-11-reproducible-evidence.md にある。
.dev-graph/plans/*/evidence/screenshots/
.dev-graph/render/*.png

# ハーネスが生成するセッションログ(成果物ではない)
.claude/logs/
